# =============================================================
# .env.example — Modèle de configuration DechetScan
# Copiez ce fichier en .env et remplissez les valeurs.
#   cp .env.example .env
# =============================================================

# Base de données MySQL
DB_PASSWORD=
MYSQL_DATABASE=dechetscan_project
MYSQL_USER=dechetscan_user
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Microservice IA
IA_SERVICE_URL=http://127.0.0.1:8001
NGROK_AGENT_API_URL=

# N8N
N8N_SECRET=

# PayDunya
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_MODE=test
PAYDUNYA_CALLBACK_URL=
PAYDUNYA_FRONTEND_URL=http://localhost:4200
PAYDUNYA_STORE_PHONE=
PAYDUNYA_STORE_ADDRESS=
PAYDUNYA_STORE_WEBSITE=

# Email delivery: configure les paramètres SMTP du fournisseur avant activation.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=DechetScan <no-reply@dechetscan.sn>

# Web Push: générer et conserver la clé privée VAPID uniquement dans .env.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_CLAIM_EMAIL=support@dechetscan.sn

# OpenRouter (microservice IA)
OPENROUTER_API_KEY=
