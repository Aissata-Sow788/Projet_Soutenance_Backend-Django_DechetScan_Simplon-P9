# =============================================================
# .env.example — Modèle de configuration DechetScan
# Copiez ce fichier en .env et remplissez les valeurs.
#   cp .env.example .env
# =============================================================

# Base de données MySQL
DB_PASSWORD=
MYSQL_DATABASE=dechetscan_project
MYSQL_USER=dechetscan_user
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Microservice IA
IA_SERVICE_URL=http://127.0.0.1:8001
NGROK_AGENT_API_URL=

# N8N
N8N_SECRET=

# PayDunya
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_MODE=test
PAYDUNYA_CALLBACK_URL=
PAYDUNYA_FRONTEND_URL=http://localhost:4200
PAYDUNYA_STORE_PHONE=
PAYDUNYA_STORE_ADDRESS=
PAYDUNYA_STORE_WEBSITE=

# Google Gemini (microservice IA)
GEMINI_API_KEY=
